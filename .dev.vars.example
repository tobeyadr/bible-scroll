# Copy to .dev.vars for `npm run dev`. For production use: npx wrangler secret put ESV_API_KEY
ESV_API_KEY=your-esv-api-key

# Illustrated theme: pictures are painted on demand. Set one of these (production: npx wrangler secret put OPENAI_API_KEY).
# OPENAI_API_KEY=your-openai-api-key
# XAI_API_KEY=your-xai-api-key
# Optional: ART_PROVIDER=openai|xai, ART_MODEL, ART_QUALITY (OpenAI), ART_DAILY_LIMIT (default 40),
# ART_API_URL (send image requests somewhere else, such as a local test double)
